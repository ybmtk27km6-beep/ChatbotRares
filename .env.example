# Provider: auto selects cloud if a supported key exists; otherwise local Ollama.
AI_PROVIDER=auto
APP_MODE=local

# Local mode
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Optional cloud mode. Groq is OpenAI-compatible; use a model/API key currently
# offered by the provider. Free quotas and availability can change.
# CLOUD_API_KEY=
# CLOUD_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_MODEL=llama-3.3-70b-versatile
# Optional image-capable model, e.g. a provider-supported Llama 4 Scout or gpt-4o-mini.
# CLOUD_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Other OpenAI-compatible providers. Never commit a real key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# OpenAI-compatible provider alternatives:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Set a stable random value for a deployed multi-user service.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
# CHAT_HISTORY_DIR=./chat_history
